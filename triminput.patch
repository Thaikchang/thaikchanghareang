 #include "pycore_pythonrun.h"     // _Py_SourceAsString()
+#include "pycore_sysmodule.h"     // _PySys_GetAutoTrimInput()
 #include "pycore_tuple.h"         // _PyTuple_Recycle()
 
 #include "clinic/bltinmodule.c.h"
 
+static PyObject *
+builtin_input_trim(PyObject *result)
+{
+    if (!_PySys_GetAutoTrimInput() || !PyUnicode_Check(result)) {
+        return Py_NewRef(result);
+    }
+
+    PyObject *strip = PyObject_GetAttr((PyObject *)&PyUnicode_Type,
+                                       &_Py_ID(strip));
+    if (strip == NULL) {
+        return NULL;
+    }
+    PyObject *trimmed = PyObject_CallOneArg(strip, result);
+    Py_DECREF(strip);
+    return trimmed;
+}
+
